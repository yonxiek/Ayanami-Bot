# ===== Ayanami System / bot configuration =====
# Скопируйте этот файл в `.env` и заполните свои значения.
# Файл `.env` НЕ коммитится в git.
#
# Локальные переопределения: можно создать `.env.local` рядом с `.env` —
# он тоже не коммитится и имеет приоритет над `.env`.
# Удобно для тестовой базы на своём компьютере (см. DB_URL ниже).

# Токен Discord-бота (обязательно) — https://discord.com/developers/applications
TOKEN=ваш_токен_бота

# Префикс для текстовых команд (не slash)
PREFIX=,

# Путь к файлу SQLite базы данных.
# Для тестов на своём ПК можно указать отдельный файл, чтобы не трогать боевую базу
# сервера. Например, локально в `.env.local`: DB_URL=data/test.db
DB_URL=data/bot.db

# Авто-бэкапы SQLite (папка и сколько последних копий хранить)
DB_BACKUP_DIR=data/backups
DB_BACKUP_KEEP=7

# Вебхук для отправки ошибок (необязательно)
ERROR_WEBHOOK_URL=

# API-ключ Bloxlink для связи Discord <-> Roblox (необязательно)
BLOXLINK_API_KEY=

# Вебхук для «снайпа» / событий (необязательно)
SNIPE_WEBHOOK_URL=

# ==== Чат с ИИ (опционально) ====
# Провайдер ИИ: gemini, openai, deepseek (по умолчанию gemini)
AI_PROVIDER=gemini

# Бесплатный ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель Gemini (при смене доступных моделей)
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (опционально) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (опционально) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ==== Музыка (Lavalink, опционально) ====
# Если пусто — музыка отключена. Lavalink: https://github.com/lavalink-devs/Lavalink
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# ==== Веб-дашборд (опционально) ====
DASHBOARD_SECRET=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

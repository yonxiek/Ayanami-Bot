# ===== Ayanami System / bot configuration =====
# Скопируйте этот файл в `.env` и заполните свои значения.
# Файл `.env` НЕ коммитится в git.

# Токен Discord-бота (обязательно) — https://discord.com/developers/applications
TOKEN=ваш_токен_бота

# Префикс для текстовых команд (не slash)
PREFIX=,

# Путь к файлу SQLite базы данных
DB_URL=data/bot.db

# Вебхук для отправки ошибок (необязательно)
ERROR_WEBHOOK_URL=

# API-ключ Bloxlink для связи Discord <-> Roblox (необязательно)
BLOXLINK_API_KEY=

# Вебхук для «снайпа» / событий (необязательно)
SNIPE_WEBHOOK_URL=

# ==== Чат с ИИ (опционально) ====
# Бесплатный ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель Gemini (при смене доступных моделей)
GEMINI_MODEL=gemini-2.0-flash
